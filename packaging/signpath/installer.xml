<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath-Artefaktkonfiguration "installer" (Slug: installer) für den zweiten Signierauftrag
  der Release-Pipeline: das fertige djsync-setup-<version>.exe.
  Maßgeblich ist die Fassung in SignPath; diese Datei ist die Vorlage dafür.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="djsync-setup-*.exe" product-name="djsync" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
